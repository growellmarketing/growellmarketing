{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "growellmarketing",
  "compatibility_date": "2026-08-25",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "html_handling": "drop-trailing-slash",
    "exclude": [
      ".git/**",
      ".github/**",
      "*.docx",
      "*.zip",
      "node_modules/**",
      ".system_generated/**",
      "scratch/**"
    ]
  }
}