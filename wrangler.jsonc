{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "growellmarketing",
  "compatibility_date": "2026-08-25",
  "main": "worker.js",
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "www.growellmarketing.com/*",
      "zone_name": "growellmarketing.com"
    },
    {
      "pattern": "growellmarketing.com/*",
      "zone_name": "growellmarketing.com"
    }
  ],
  "assets": {
    "directory": ".",
    "html_handling": "drop-trailing-slash"
  }
}
